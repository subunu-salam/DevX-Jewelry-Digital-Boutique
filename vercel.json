{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "devx-boutique-web": {
      "root": "apps/boutique",
      "framework": "vite",
      "buildCommand": "npm run build"
    },
    "devx-boutique-crm": {
      "root": "apps/crm",
      "framework": "vite",
      "buildCommand": "npm run build"
    },
    "devx-boutique-api": {
      "root": "server",
      "framework": "express",
      "entrypoint": "vercel/index.mjs",
      "buildCommand": "npm run build:vercel && npx prisma migrate deploy"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "devx-boutique-api" } },
    { "source": "/health", "destination": { "service": "devx-boutique-api" } },
    { "source": "/crm/(.*)", "destination": { "service": "devx-boutique-crm" } },
    { "source": "/crm", "destination": { "service": "devx-boutique-crm" } },
    { "source": "/(.*)", "destination": { "service": "devx-boutique-web" } }
  ],
  "crons": [
    { "path": "/api/cron/gold", "schedule": "30 3 * * *" }
  ]
}
