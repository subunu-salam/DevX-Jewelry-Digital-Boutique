# ─────────────────────────────────────────────────────────────
# DevX Boutique OS — environment configuration
# Copy to .env at the repo root AND inside /server before running.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Render provides this automatically in prod).
# For local dev with the bundled docker-compose Postgres:
DATABASE_URL="postgresql://devx:devx@localhost:5433/devx_boutique?schema=public"

# JWT signing secret — set a long random value in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# API server
PORT=4000
NODE_ENV=development

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ── Gold price provider ─────────────────────────────────────────
# Server-side ingestion only. Default "gold-api" uses https://api.gold-api.com
# (live XAU price, NO API KEY REQUIRED), converted to AED/gram per karat.
# Providers: "gold-api" (keyless, default) | "goldapi" (needs key) |
#            "metalsdev" (needs key) | "none" (persisted history + manual only)
GOLD_PROVIDER="gold-api"   # keyless, real live rate from api.gold-api.com
USD_AED="3.6725"          # USD→AED conversion used with gold-api
GOLDAPI_KEY=""
METALSDEV_KEY=""

# ── Optional AI provider (visual search + catalog copy) ─────────
# Leave blank for the built-in fallbacks (owner Intelligence works without a key).
OPENAI_API_KEY=""
# How often (minutes) the worker fetches a fresh observation.
GOLD_INGEST_INTERVAL_MINUTES=60

# ── Frontend build-time variables (apps/boutique, apps/crm) ─────
# In each app create a .env with:
# VITE_API_URL="http://localhost:4000"
