{
  "name": "Aurelia Fine Jewellery — Digital Boutique",
  "short_name": "Aurelia",
  "description": "Discover, save and reserve fine jewellery across our Dubai and Abu Dhabi boutiques.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
